    if Filled then
        Btn.BackgroundColor3 = COLOR_ACCENT
        Btn.TextColor3 = Color3.fromRGB(10, 10, 10)
    else
        Btn.BackgroundColor3 = COLOR_SIDE
        Btn.TextColor3 = COLOR_TEXT
