local Closed = false
local Busy = false

local function CloseUI()
    if Closed then return end
    Closed = true

    Tween(Card, 0.45, {Position = UDim2.new(0.5, 0, 0.5, -10)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    FadeAll(true, 0.4)

    task.delay(0.5, function()
        SpinTween:Cancel()
        Cleanup()
        ScreenGui:Destroy()
    end)
end

local function SetStatus(Text, Color)
    StatusLabel.Text = Text
    StatusLabel.TextColor3 = Color or COLOR_ACCENT
end

local function LoadExternal(Url, Name)
    if Busy or Closed then return end
    Busy = true

    SpinnerHolder.Visible = true
    SpinTween:Play()

    task.spawn(function()
        -- รอ 4 วินาทีก่อนเริ่มโหลดสคริปต์ (แสดงนับถอยหลัง)
        for i = 4, 1, -1 do
            if Closed then return end
            SetStatus("เลือก " .. Name .. " • เริ่มโหลดใน " .. i .. " วินาที", COLOR_ACCENT)
            task.wait(1)
        end

        if Closed then return end
        SetStatus("กำลังโหลด " .. Name .. "...", COLOR_ACCENT)

        local Success, Result = pcall(function()
            local Source = game:HttpGet(Url, true)

            if not Source or Source == "" then
                error("Script source is empty")
            end

            local Func, Err = loadstring(Source)
            if not Func then
                error(Err or "Compile failed")
            end

            return Func
        end)

        SpinTween:Cancel()
        SpinnerHolder.Visible = false

        if not Success then
            warn("โหลดสคริปต์ไม่สำเร็จ:", Result)
            SetStatus("โหลดไม่สำเร็จ", COLOR_ERROR)
            Busy = false
            return
        end

        SetStatus("โหลด " .. Name .. " สำเร็จ", COLOR_OK)

        -- รันสคริปต์ในเธรดแยก จะได้ไม่ค้าง UI ถ้าสคริปต์มี loop หรือ wait ยาว
        task.spawn(function()
            local Ran, RunErr = pcall(Result)
            if not Ran then
                warn("สคริปต์ error ตอนรัน:", RunErr)
            end
        end)

        task.wait(0.4)
        CloseUI()
    end)
end

local function SetupButton(Btn, BaseColor, Name, Url)
    Btn.MouseEnter:Connect(function()
        if Closed or Busy then return end
        local Hover = BaseColor:Lerp(Color3.fromRGB(120, 120, 120), 0.25)
        Tween(Btn, 0.15, {BackgroundColor3 = Hover})
    end)

    Btn.MouseLeave:Connect(function()
        if Closed then return end
        Tween(Btn, 0.15, {BackgroundColor3 = BaseColor})
    end)

    Btn.MouseButton1Click:Connect(function()
        LoadExternal(Url, Name)
    end)
end

