        S.Thickness = 1.2
        S.Parent = Btn
        Track(S, "Transparency", 0.5)
    end

    Track(Btn, "BackgroundTransparency", 0)
    Track(Btn, "TextTransparency", 0)
    return Btn, Filled and COLOR_ACCENT or COLOR_SIDE
end

