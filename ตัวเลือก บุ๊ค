local function updateResponsive()
    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local viewport = camera.ViewportSize
    local width = viewport.X
    local height = viewport.Y
    local mobile = width <= 600

    if mobile then
        main.Size = UDim2.fromOffset(
            math.clamp(width - 30, 280, 390),
            math.clamp(height - 80, 330, 390)
        )

        scale.Scale = math.clamp(width / 430, 0.78, 0.95)

        btnContainer.Size = UDim2.new(1, -10, 0, 122)
        btnContainer.Position = UDim2.new(0.5, 0, 0, 198)

        listLayout.FillDirection = Enum.FillDirection.Vertical
        listLayout.Padding = UDim.new(0, 10)

        option1Btn.Size = UDim2.new(1, -20, 0, 52)
        option2Btn.Size = UDim2.new(1, -20, 0, 52)

        title.TextSize = 20
        desc.TextSize = 13
        statusLabel.Position = UDim2.new(0.5, 0, 0, 330)
    else
        main.Size = UDim2.fromOffset(
            math.clamp(width * 0.34, 420, 520),
            400
        )

        scale.Scale = math.clamp(width / 1200, 0.95, 1.08)

        btnContainer.Size = UDim2.new(1, 0, 0, 56)
        btnContainer.Position = UDim2.new(0.5, 0, 0, 200)

        listLayout.FillDirection = Enum.FillDirection.Horizontal
        listLayout.Padding = UDim.new(0, 16)

        option1Btn.Size = UDim2.fromOffset(180, 56)
        option2Btn.Size = UDim2.fromOffset(180, 56)

        title.TextSize = 22
        desc.TextSize = 14
        statusLabel.Position = UDim2.new(0.5, 0, 0, 266)
    end
end

local function closeUI()
    if closed then
        return
    end

    closed = true

    TweenService:Create(
        main,
        TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In),
        {Size = UDim2.fromOffset(0, 0)}
    ):Play()

    TweenService:Create(
        overlay,
        TweenInfo.new(0.25),
        {BackgroundTransparency = 1}
    ):Play()

    TweenService:Create(
        blur,
        TweenInfo.new(0.3),
        {Size = 0}
    ):Play()

    task.delay(0.3, function()
        if screenGui then
            screenGui:Destroy()
        end

        if blur and blur.Parent then
            blur:Destroy()
        end
    end)
end

local function loadExternal(url, name)
    if closed then
        return
    end

    statusLabel.Text = "กำลังโหลด " .. name .. "..."

    TweenService:Create(
        statusLabel,
        TweenInfo.new(0.2),
        {TextTransparency = 0}
    ):Play()

    task.spawn(function()
        local success, result = pcall(function()
            local source = game:HttpGet(url)
            local func, err = loadstring(source)

            if not func then
                error(err or "ไม่สามารถโหลดสคริปต์ได้")
            end

            return func()
        end)

        if not success then
            warn("โหลดสคริปต์ไม่สำเร็จ:", result)

            if statusLabel.Parent then
                statusLabel.Text = "โหลดไม่สำเร็จ"
            end

            return
        end

        if statusLabel.Parent then
            statusLabel.Text = "โหลด " .. name .. " สำเร็จ"
        end

        task.delay(0.5, closeUI)
    end)
end

local function setupButtonEffects(btn, resultText, url)
    local originalSize = btn.Size

    btn.MouseEnter:Connect(function()
        if closed then
            return
        end

        TweenService:Create(
            btn,
            TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Rotation = -2}
        ):Play()
    end)

    btn.MouseLeave:Connect(function()
        if closed then
            return
        end

        TweenService:Create(
            btn,
            TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {
                Rotation = 0,
                Size = originalSize
            }
        ):Play()
    end)

    btn.MouseButton1Down:Connect(function()
        if closed then
            return
        end

        TweenService:Create(
            btn,
            TweenInfo.new(0.08),
            {Size = originalSize - UDim2.fromOffset(6, 3)}
        ):Play()
    end)

    btn.MouseButton1Click:Connect(function()
        if closed then
            return
        end

        TweenService:Create(
            mainStroke,
            TweenInfo.new(0.15),
            {
                Color = Color3.fromRGB(120, 200, 255),
                Transparency = 0
            }
        ):Play()

        loadExternal(url, resultText)
    end)
end

